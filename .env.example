# Supabase 콘솔 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── 아래는 실거래가 적재 배치(loader)만 쓴다. 앱(웹)에는 넘기지 않는다. 절대 NEXT_PUBLIC_ 을 붙이지 말 것 ──
# 공공데이터포털(data.go.kr) → 마이페이지 → 개발계정 → 일반 인증키(Decoding)
MOLIT_SERVICE_KEY=
# Supabase 콘솔 → Project Settings → API Keys → Secret key (service_role 권한: RLS 를 거치지 않는다)
SUPABASE_SECRET_KEY=sb_secret_...
# 한 번 실행에서 부를 최대 구·월 수. data.go.kr 개발계정 일일 트래픽 한도보다 작게(마이페이지에서 확인)
MOLIT_DAILY_BUDGET=800
